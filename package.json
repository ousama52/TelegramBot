{
  "name": "telegram-card-and-tile-games",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc",
    "db:migrate": "npm run build --silent && node dist/scripts/migrate.js",
    "dev": "npm run build --silent && node dist/scripts/dev.js",
    "stickers:build": "tsc --target ES2022 --module NodeNext --strict --rootDir scripts --outDir .sticker-build scripts/build-stickers.ts && node .sticker-build/build-stickers.js",
    "stickers:upload": "npm run build --silent && node dist/scripts/upload-stickers.js",
    "webhook:set": "npm run build --silent && node dist/scripts/set-webhook.js",
    "webhook:delete": "npm run build --silent && node dist/scripts/delete-webhook.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/functions": "^3.11.3",
    "abort-controller": "^3.0.0",
    "dotenv": "^17.2.3",
    "grammy": "^1.39.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
